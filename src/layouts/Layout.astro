---
import FollowLinks from '../components/FollowLinks.astro';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import displayFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url';
import site from '../../site.config.mjs';
import { url } from '../lib';
import Analytics from '../components/Analytics.astro';
import { ClientRouter } from 'astro:transitions';
const {
  title = 'Encrypted Cat Games | Independent game studio',
  description = 'Encrypted Cat Games is an independent studio making The Cradle, an episodic horror series, and Destruction Cars, a car-mayhem game in development. Play, read the devlog and follow along.',
  image = '/images/og-studio.jpg',
  imageAlt = 'Encrypted Cat Games: The Cradle, a horror series, and Destruction Cars, a car-mayhem game. Dark stories. Loud crashes.',
  type = 'website',
  noindex = false,
  structuredData,
} = Astro.props;
const canonical = new URL(
  noindex ? url('404.html') : Astro.url.pathname,
  site.siteUrl,
);
const nav = [
  ['Games', 'games/'],
  ['Devlog', 'devlog/'],
  ['Projects', 'other-projects/'],
  ['Contact', 'contact/'],
];
const analyticsEnabled =
  /^G-[A-Z0-9]+$/.test(site.analyticsId) && site.analyticsId !== 'G-XXXXXXXXXX';
const current = (path: string) =>
  Astro.url.pathname.includes('/' + path) ? 'page' : undefined;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c0c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url(image), site.siteUrl)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} devlog`}
      href={url('devlog/rss.xml')}
    />
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="header" transition:persist="site-header">
      <div class="nav-wrap">
        <a class="brand" href={url()} aria-label="Encrypted Cat Games home">
          <img src={url('images/avatar.webp')} width="44" height="44" alt="" />
          <span>
            ENCRYPTED CAT<small>GAMES</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="Main navigation" data-nav>
          {nav.map(([label, path]) => (
            <a href={url(path)} aria-current={current(path)}>
              {label}
            </a>
          ))}
        </nav>
        <a class="nav-follow" href="#follow">
          Follow
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <span class="menu-label">Menu</span>
          <span class="menu-icon" aria-hidden="true"></span>
        </button>
      </div>
      <div class="mobile-menu" id="mobile-menu" hidden data-menu>
        <div class="mobile-menu-inner">
          <nav class="mobile-menu-links" aria-label="Main navigation" data-nav>
            <a href={url()}>Home</a>
            {nav.map(([label, path]) => (
              <a href={url(path)} aria-current={current(path)}>
                {label}
              </a>
            ))}
          </nav>
          <div class="mobile-menu-follow">
            <p class="eyebrow">Follow the studio</p>
            <FollowLinks notes={false} label="Follow the studio (menu)" />
          </div>
        </div>
      </div>
    </header>
    <main id="main" transition:name="page-content" transition:animate="none">
      <slot />
    </main>
    <footer class="footer" id="follow" transition:persist="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="footer-brand" href={url()}>
            ENCRYPTED CAT GAMES
          </a>
          <p>
            Independent games: narrative horror and car mayhem. Follow along as
            we build them.
          </p>
        </div>
        <div class="footer-follow">
          <p class="footer-follow-title">Follow the studio</p>
          <FollowLinks label="Studio channels" />
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Encrypted Cat Games</span>
          <div>
            <a href={url('support/')}>Player support</a>
            <a href={url('privacy/')}>Privacy policy</a>
            <a href={url('terms/')}>Terms</a>
            <a href={url('other-projects/')}>Projects</a>
            <a href={url('devlog/rss.xml')}>RSS</a>
            {analyticsEnabled && (
              <button class="footer-button" type="button" data-consent-open>
                Cookie settings
              </button>
            )}
          </div>
        </div>
      </div>
    </footer>
    <Analytics />
    <script>
      import '../scripts/interactions';
      // The shell persists; update its current-page state before painting the next route.
      const home = new URL(
        document.querySelector<HTMLAnchorElement>('.brand')!.href,
      ).pathname;
      function updateNavigation() {
        document
          .querySelectorAll<HTMLAnchorElement>('[data-nav] a')
          .forEach((link) => {
            const path = new URL(link.href).pathname;
            if (
              location.pathname === path ||
              (path !== home && location.pathname.startsWith(path))
            )
              link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
          });
      }
      updateNavigation();
      document.addEventListener('astro:after-swap', updateNavigation);
      document.addEventListener('astro:page-load', updateNavigation);
    </script>
  </body>
</html>
