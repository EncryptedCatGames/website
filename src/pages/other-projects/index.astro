---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<Layout
  title="Projects | Encrypted Cat Games"
  description="Side projects from Encrypted Cat Games beyond our games, including gobnative, a browser runtime for the Goblins trilogy, and OpenWhisp, local dictation for macOS."
>
  <section class="container page-intro">
    <p class="eyebrow">Beyond the games</p>
    <h1>Projects.</h1>
    <p>
      Side quests, experiments, and a few old favourites brought back to life.
    </p>
  </section>
  <section class="container section project-list" aria-label="Projects">
    {projects.map((project) => (
      <ProjectCard project={project} headingLevel={2} />
    ))}
  </section>
</Layout>

<style>
  .project-list {
    padding-top: 0;
  }
</style>
