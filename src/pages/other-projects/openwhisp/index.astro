---
import Layout from '../../../layouts/Layout.astro';
import { projects } from '../../../data/projects';
import { url } from '../../../lib';
const project = projects.find((p) => p.slug === 'openwhisp')!;
const site = project.site!;
const source = 'https://github.com/initcore0/openwhisp';
---

<Layout
  title="OpenWhisp | Encrypted Cat Games"
  description="OpenWhisp: free, open-source realtime dictation for macOS that runs entirely on your Mac. Everything about it lives at openwhisp.app."
  image="/other-projects/openwhisp/og-image.png"
  imageAlt="OpenWhisp: a glowing waveform over the words 'Speak. It's typed. Nothing leaves your Mac.'"
>
  <section class="container page-intro openwhisp">
    <a class="text-link back" href={url('other-projects/')}>
      ← Projects
    </a>
    <p class="eyebrow">{project.kind}</p>
    <h1>OpenWhisp.</h1>
    <p>{project.description}</p>
    <a class="openwhisp-art" href={site} aria-label="Visit openwhisp.app">
      <img
        src={url('other-projects/openwhisp/og-image.png')}
        width="1200"
        height="630"
        alt="A glowing waveform over the words: Speak. It’s typed. Nothing leaves your Mac."
      />
    </a>
    <div class="openwhisp-actions">
      <a class="button" href={site}>
        Visit openwhisp.app
      </a>
      <a class="text-link" href={source}>
        Source on GitHub
      </a>
    </div>
    <p class="openwhisp-note">
      Downloads, guides and articles live on its own site.
    </p>
  </section>
</Layout>

<style>
  .back {
    margin-bottom: 24px;
  }
  .openwhisp-art {
    display: block;
    max-width: 880px;
    margin-block: 40px 32px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .openwhisp-art:hover {
    border-color: #88806b;
  }
  .openwhisp-art img {
    display: block;
    width: 100%;
    height: auto;
  }
  .openwhisp-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .openwhisp-note {
    margin-top: 20px;
    font-size: 14px !important;
    color: var(--muted);
  }
</style>
