---
import Layout from '../layouts/Layout.astro';
import FollowLinks from '../components/FollowLinks.astro';
import { fullName } from '../data/games';
import { series } from '../data/series';
import { subjectName } from '../data/subjects';
import { getCollection } from 'astro:content';
import { url, formatDate } from '../lib';
import { homeData } from '../data/structured-data';
// One slide per game, taking turns between the series so the genres alternate.
const longest = Math.max(...series.map((s) => s.games.length));
const slides = Array.from({ length: longest }, (_, i) =>
  series.map((s) => s.games[i]),
)
  .flat()
  .filter((game) => game?.hero);
const posts = (await getCollection('devlog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout structuredData={homeData}>
  <section
    class="landing"
    data-carousel
    aria-roledescription="carousel"
    aria-label="Our games"
  >
    {slides.map((game, i) => (
      <article
        class:list={['slide', { active: i === 0 }]}
        data-slide
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${slides.length}: ${fullName(game)}`}
        aria-hidden={i === 0 ? undefined : 'true'}
        inert={i !== 0}
      >
        <img
          src={url(game.hero!.image)}
          alt={game.hero!.alt}
          width="1600"
          height="900"
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
        />
        <div class="container slide-copy">
          <p class="slide-meta">
            <span>{game.kind}</span>
            <span>{game.status}</span>
          </p>
          <h2>
            {(game.subtitle || game.workingTitle) && (
              <small>{game.subtitle ? game.title : 'Codename'}</small>
            )}
            {game.subtitle || game.title}
          </h2>
          <p>{game.short}</p>
          <a class="slide-cta" href={url(`games/${game.slug}/`)}>
            See the game
          </a>
        </div>
      </article>
    ))}
    <div class="container landing-head">
      <p class="eyebrow">Independent game studio</p>
      <h1>
        Dark stories. <span>Loud crashes.</span>
      </h1>
    </div>
    <div class="container landing-bar">
      <div class="slide-dots" role="group" aria-label="Choose a game">
        {slides.map((game, i) => (
          <button
            type="button"
            data-slide-to={i}
            aria-label={`Show ${fullName(game)}`}
            aria-current={i === 0 ? 'true' : 'false'}
          >
            <span>{game.subtitle || game.title}</span>
          </button>
        ))}
      </div>
      <FollowLinks compact />
    </div>
  </section>
  <section class="section container latest">
    <div class="section-heading">
      <h2>Latest.</h2>
      <a class="text-link" href={url('devlog/')}>
        All devlog posts
      </a>
    </div>
    <ul class="latest-list">
      {posts.map((post) => (
        <li>
          <a href={url(`devlog/${post.id}/`)}>
            <span class="latest-meta">
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <span>{subjectName(post.data.game)}</span>
            </span>
            <strong>{post.data.title}</strong>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
