---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { games } from '../data/games';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
import { url } from '../lib';
import site from '../../site.config.mjs';
const posts = (await getCollection('devlog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const latest = games[0];
const socialNotes: Record<string, string> = {
  Discord: 'Chat with players',
  YouTube: 'Trailers and videos',
  Reddit: 'Theories and discussion',
  'itch.io': 'Follow new releases',
  Twitch: 'Live development',
};
---

<Layout>
  <section class="hero">
    <div class="hero-art">
      <img
        src={url('images/hero-doorway.webp')}
        alt=""
        width="744"
        height="820"
        fetchpriority="high"
      />
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Independent horror games</p>
        <h1>
          Small games. Dark stories.
          <span>Lingering nightmares.</span>
        </h1>
        <p>
          Atmospheric horror from forgotten places, strange signals, and things
          better left undiscovered.
        </p>
        <div class="hero-actions">
          <a
            class="text-link"
            href={latest.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Play ${latest.title}: ${latest.subtitle} on itch.io`}
          >
            Play The Cradle on itch.io
          </a>
          <a class="text-link" href="#games">
            Browse games
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="section container" id="games">
    <div class="section-heading">
      <h2>Games.</h2>
      <a class="text-link" href={url('games/')}>
        All games
      </a>
    </div>
    <div class="game-grid">
      {games.map((game) => (
        <GameCard game={game} />
      ))}
    </div>
  </section>
  <section class="section container" id="projects">
    <div class="section-heading">
      <h2>Other projects.</h2>
      <a class="text-link" href={url('other-projects/')}>
        All projects
      </a>
    </div>
    <div class="project-list">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <h2>Latest updates.</h2>
      <a class="text-link" href={url('devlog/')}>
        Devlog
      </a>
    </div>
    <PostList posts={posts} />
  </section>
  <section class="container section">
    <div class="community">
      <div class="community-copy">
        <p class="eyebrow">Join the community</p>
        <h2>Come closer.</h2>
        <p>
          Encrypted Cat Games is the independent horror project of Encrypted
          Cat, also known as 0xKOT. Share theories, report bugs, and follow new
          episodes as they take shape.
        </p>
        <a class="text-link" href={url('contact/')}>
          Contact us
        </a>
      </div>
      <div class="social-grid">
        {site.socials.map((s) => (
          <a
            class="social-tile"
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <SocialIcon name={s.name} />
            <span>
              <strong>{s.name}</strong>
              <small>{socialNotes[s.name]}</small>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
