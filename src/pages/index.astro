---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import FollowLinks from '../components/FollowLinks.astro';
import SeriesBlock from '../components/SeriesBlock.astro';
import { series } from '../data/series';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
import { url } from '../lib';
import { homeData } from '../data/structured-data';
import { seriesPath } from '../data/subjects';
const posts = (await getCollection('devlog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout structuredData={homeData}>
  <section class="studio-hero">
    <div class="container">
      <div class="studio-intro">
        <p class="eyebrow">Independent game studio</p>
        <h1>
          Dark stories.
          <span>Loud crashes.</span>
        </h1>
        <p>
          Encrypted Cat Games makes narrative horror and car-mayhem action for
          the browser, desktop and phones. Play what’s out, watch what’s coming,
          and follow along.
        </p>
      </div>
      <div class="worlds">
        {series.map((item, i) => (
          <a class="world" href={url(seriesPath(item.slug))}>
            <img
              src={url(item.image)}
              alt={item.imageAlt}
              width="1200"
              height="675"
              fetchpriority={i === 0 ? 'high' : undefined}
            />
            <span class="world-copy">
              <span class="world-genre">{item.genre}</span>
              <strong>{item.name}</strong>
              <span class="world-pitch">{item.pitch}</span>
              <span class="world-status">{item.status}</span>
            </span>
          </a>
        ))}
      </div>
      <div class="hero-follow">
        <p>Follow the studio</p>
        <FollowLinks notes={false} />
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <h2>Latest updates.</h2>
      <a class="text-link" href={url('devlog/')}>
        All devlog posts
      </a>
    </div>
    <PostList posts={posts} />
  </section>
  <section class="section container" id="games">
    <div class="section-heading">
      <h2>Games.</h2>
      <a class="text-link" href={url('games/')}>
        All games
      </a>
    </div>
    <div class="series-stack">
      {series.map((item) => (
        <SeriesBlock series={item} />
      ))}
    </div>
  </section>
  <section class="section container" id="projects">
    <div class="section-heading">
      <h2>Other projects.</h2>
      <a class="text-link" href={url('other-projects/')}>
        All projects
      </a>
    </div>
    <div class="project-list">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</Layout>
