---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PostList from '../components/PostList.astro';
import { games } from '../data/games';
import { getCollection } from 'astro:content';
import { url } from '../lib';
const posts = (await getCollection('devlog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>
  <section class="hero">
    <img
      class="hero-banner"
      src={url('images/banner.webp')}
      alt="Encrypted Cat Games. Narrative horror, one episode at a time. A figure waits in a lit sanatorium doorway."
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <div class="container hero-bottom">
      <div>
        <h1>
          Small games. Dark stories.
          <br />
          <span>Lingering nightmares.</span>
        </h1>
        <p>
          Atmospheric horror from forgotten places, strange signals,
          <br class="desktop-break" /> and things better left undiscovered.
        </p>
      </div>
      <a class="button" href={url('games/')}>
        Find your next nightmare <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="section container" id="games">
    <div class="section-heading">
      <h2>Enter The Cradle.</h2>
      <a class="text-link" href={url('games/')}>
        All games <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="game-grid">
      {games.map((game) => (
        <GameCard game={game} />
      ))}
    </div>
  </section>
  <section class="studio-section">
    <div class="container studio-grid">
      <div class="studio-photo">
        <img
          src={url('images/episode-01-2.webp')}
          width="1600"
          height="900"
          alt="A dark interior from The Cradle: Episode 01"
          loading="lazy"
        />
      </div>
      <div class="studio-copy">
        <p class="eyebrow">Behind the door</p>
        <h2>
          Stories that stay
          <br />
          after the screen goes dark.
        </h2>
        <p>
          Encrypted Cat Games is the independent horror project of Encrypted
          Cat, also known as 0xKOT.
        </p>
        <p>
          We build unsettling places to explore, stories to piece together, and
          encounters that make you listen before you move.
        </p>
        <a class="text-link" href={url('devlog/')}>
          See how we make them <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <h2>From the devlog.</h2>
      <a class="text-link" href={url('devlog/')}>
        All updates <span aria-hidden="true">↗</span>
      </a>
    </div>
    <PostList posts={posts} />
  </section>
  <section class="contact-strip container">
    <div>
      <h2>Found something in the dark?</h2>
      <p>A bug, a question, or a story to share. We’re listening.</p>
    </div>
    <a class="button button-secondary" href={url('contact/')}>
      Get in touch <span aria-hidden="true">↗</span>
    </a>
  </section>
</Layout>
