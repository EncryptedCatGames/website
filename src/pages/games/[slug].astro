---
import LinkMark from '../../components/LinkMark.astro';
import Layout from '../../layouts/Layout.astro';
import GameStoreLink from '../../components/GameStoreLink.astro';
import PostList from '../../components/PostList.astro';
import GameCard from '../../components/GameCard.astro';
import { games } from '../../data/games';
import { url } from '../../lib';
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}
const { game } = Astro.props;
const others = games.filter((other) => other.slug !== game.slug);
const posts = (await getCollection('devlog'))
  .filter((p) => p.data.game === game.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout
  title={`${game.title}: ${game.subtitle} | Encrypted Cat Games`}
  description={game.description}
  image={game.cover}
>
  <section class="game-hero">
    <img
      src={url(game.screenshots[0] || game.cover)}
      alt={`${game.title}: ${game.subtitle} gameplay`}
      width="1600"
      height="900"
      fetchpriority="high"
    />
    <div class="container game-hero-copy">
      <a class="back-link" href={url('games/')}>
        ← All games
      </a>
      <p class="eyebrow">{game.kind}</p>
      <h1>
        {game.title}
        <span>{game.subtitle}</span>
      </h1>
      <ul class="game-meta game-hero-meta" aria-label="Details">
        <li class="game-status">{game.status}</li>
        <li>{game.length}</li>
        <li>{game.platforms}</li>
      </ul>
      <GameStoreLink
        title={`${game.title}: ${game.subtitle}`}
        href={game.url}
      />
    </div>
  </section>
  <section class="container section game-overview">
    <div>
      <h2>{game.short}</h2>
      <p class="lead">{game.description}</p>
      <div class="facts">
        <div>
          <span>Status</span>
          <strong>{game.status}</strong>
        </div>
        <div>
          <span>Play time</span>
          <strong>{game.length}</strong>
        </div>
        <div>
          <span>Available on</span>
          <strong>{game.platforms}</strong>
        </div>
        <div>
          <span>Languages</span>
          <strong>{game.languages}</strong>
        </div>
      </div>
    </div>
    <aside id="play">
      <h2>Step inside.</h2>
      <p>Available now on itch.io.</p>
      <GameStoreLink
        title={`${game.title}: ${game.subtitle}`}
        href={game.url}
      />
      {game.appStoreUrl && (
        <a class="button" href={game.appStoreUrl}>
          Download on the App Store
        </a>
      )}
      <p class="content-warning">
        <strong>Content warning</strong>
        {game.warning}
      </p>
    </aside>
  </section>
  <section class="container game-features">
    {game.features.map(([title, copy]) => (
      <div>
        <h3>{title}</h3>
        <p>{copy}</p>
      </div>
    ))}
  </section>
  <section class="container section">
    <h2 class="gallery-heading">A look inside.</h2>
    <div class="screenshot-gallery">
      {game.screenshots.slice(1, 5).map((src, i) => (
        <a
          href={url(src)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View gameplay screenshot ${i + 1} at full size`}
        >
          <img
            src={url(src)}
            width="1600"
            height="900"
            loading="lazy"
            alt={`${game.title}: ${game.subtitle}, gameplay screenshot ${i + 1}`}
          />
        </a>
      ))}
    </div>
  </section>
  {posts.length > 0 && (
    <section class="container section">
      <div class="section-heading">
        <h2>Development notes.</h2>
        <a class="text-link" href={url('devlog/')}>
          All updates <LinkMark />
        </a>
      </div>
      <PostList posts={posts} />
    </section>
  )}
  {others.length > 0 && (
    <section class="container section">
      <div class="section-heading">
        <h2>More to play.</h2>
        <a class="text-link" href={url('games/')}>
          All games <LinkMark />
        </a>
      </div>
      <div class="game-grid">
        {others.map((other) => (
          <GameCard game={other} />
        ))}
      </div>
    </section>
  )}
  <section class="container contact-strip">
    <div>
      <h2>Need a hand?</h2>
      <p>Find help with controls, devices, or a bug you encountered.</p>
    </div>
    <a class="button button-secondary" href={url('support/')}>
      Player support <LinkMark />
    </a>
  </section>
</Layout>
