---
import Layout from '../../layouts/Layout.astro';
import GameStoreLink from '../../components/GameStoreLink.astro';
import PostList from '../../components/PostList.astro';
import GameCard from '../../components/GameCard.astro';
import Trailer from '../../components/Trailer.astro';
import { fullName, games } from '../../data/games';
import { url } from '../../lib';
import { gameData } from '../../data/structured-data';
import site from '../../../site.config.mjs';
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}
const { game } = Astro.props;
const name = fullName(game);
const youtube = site.socials.find((social) => social.name === 'YouTube');
const platforms = game.comingSoon
  ? `${game.platforms} · ${game.comingSoon} (coming soon)`
  : game.platforms;
const others = games.filter((other) => other.slug !== game.slug);
const posts = (await getCollection('devlog'))
  .filter((p) => p.data.game === game.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout
  title={`${name} | Encrypted Cat Games`}
  description={game.description}
  image={game.cover}
  structuredData={gameData(game)}
  imageAlt={`${name} cover art`}
>
  <section class="game-hero">
    <img
      src={url(game.screenshots[0] || game.cover)}
      alt={`${name} gameplay`}
      width="1600"
      height="900"
      fetchpriority="high"
    />
    <div class="container game-hero-copy">
      <a class="back-link" href={url('games/')}>
        All games
      </a>
      <p class="eyebrow">{game.kind}</p>
      <h1>
        {game.title}
        {game.subtitle && <span>{game.subtitle}</span>}
      </h1>
      {game.workingTitle && (
        <p class="wip-note">Working title · heavy work in progress</p>
      )}
      <ul class="game-meta game-hero-meta" aria-label="Details">
        <li class="game-status">{game.status}</li>
        <li>{game.length}</li>
        <li>{platforms}</li>
      </ul>
      {game.url ? (
        <GameStoreLink title={name} href={game.url} />
      ) : (
        game.trailer && (
          <a class="text-link" href="#trailer">
            Watch the teaser
          </a>
        )
      )}
    </div>
  </section>
  {game.trailer && (
    <section class="container section game-trailer" id="trailer">
      <Trailer {...game.trailer} />
    </section>
  )}
  <section class="container section game-overview">
    <div>
      <h2>{game.short}</h2>
      <p class="lead">{game.description}</p>
      <div class="facts">
        <div>
          <span>Status</span>
          <strong>{game.status}</strong>
        </div>
        <div>
          <span>Play time</span>
          <strong>{game.length}</strong>
        </div>
        <div>
          <span>Available on</span>
          <strong>{platforms}</strong>
        </div>
        <div>
          <span>Languages</span>
          <strong>{game.languages}</strong>
        </div>
      </div>
    </div>
    <aside id="play">
      {game.url ? (
        <>
          <h2>Step inside.</h2>
          <p>Available now on itch.io.</p>
        </>
      ) : (
        <>
          <h2>Not playable yet.</h2>
          <p>
            Still being built, and everything you see may change, including the
            name.
          </p>
          {youtube && (
            <a
              class="text-link"
              href={youtube.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Follow development on YouTube
            </a>
          )}
        </>
      )}
      {game.comingSoon && !game.appStoreUrl && (
        <p>Coming soon to the App Store for iPhone and iPad.</p>
      )}
      {game.url && <GameStoreLink title={name} href={game.url} />}
      {game.appStoreUrl && (
        <a class="text-link" href={game.appStoreUrl}>
          Download on the App Store
        </a>
      )}
      <p class="content-warning">
        <strong>Content warning</strong>
        {game.warning}
      </p>
    </aside>
  </section>
  <section class="container game-features">
    {game.features.map(([title, copy]) => (
      <div>
        <h3>{title}</h3>
        <p>{copy}</p>
      </div>
    ))}
  </section>
  <section class="container section">
    <h2 class="gallery-heading">A look inside.</h2>
    <div class="screenshot-gallery">
      {game.screenshots.slice(1, 5).map((src, i) => (
        <a
          href={url(src)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View gameplay screenshot ${i + 1} at full size`}
        >
          <img
            src={url(src)}
            width="1600"
            height="900"
            loading="lazy"
            alt={`${name}, gameplay screenshot ${i + 1}`}
          />
        </a>
      ))}
    </div>
  </section>
  {posts.length > 0 && (
    <section class="container section">
      <div class="section-heading">
        <h2>Development notes.</h2>
        <a class="text-link" href={url('devlog/')}>
          All updates
        </a>
      </div>
      <PostList posts={posts} />
    </section>
  )}
  {others.length > 0 && (
    <section class="container section">
      <div class="section-heading">
        <h2>More to play.</h2>
        <a class="text-link" href={url('games/')}>
          All games
        </a>
      </div>
      <div class="game-grid">
        {others.map((other) => (
          <GameCard game={other} />
        ))}
      </div>
    </section>
  )}
  <section class="container contact-strip">
    <div>
      <h2>Need a hand?</h2>
      <p>Find help with controls, devices, or a bug you encountered.</p>
    </div>
    <a class="text-link" href={url('support/')}>
      Player support
    </a>
  </section>
</Layout>
