---
import Layout from '../../layouts/Layout.astro';
import SeriesBlock from '../../components/SeriesBlock.astro';
import { games } from '../../data/games';
import { series } from '../../data/series';
import { platforms, type Platform } from '../../data/platforms';
import { url } from '../../lib';
// Genre filter values: one per genre the games have, in catalogue order.
const genres = [...new Set(games.map((game) => game.genre))];
const filters = [
  {
    name: 'genre',
    label: 'Filter by genre',
    all: 'Every genre',
    values: genres.map((genre) => [genre.toLowerCase(), genre]),
  },
  {
    name: 'platform',
    label: 'Filter by platform',
    all: 'Any platform',
    // Only platforms some game runs on.
    values: Object.entries(platforms).filter(([value]) =>
      games.some((game) => game.platformTags.includes(value as Platform)),
    ),
  },
];
---

<Layout
  title="Games | Encrypted Cat Games"
  description="Every Encrypted Cat game by series: The Cradle, an episodic narrative horror series, and Destruction Cars, a car-mayhem game in development."
>
  <section class="container page-intro">
    <p class="eyebrow">The catalogue</p>
    <h1>Our games.</h1>
    <p>
      Every game we make, grouped by series. Filter by genre or by where you
      want to play.
    </p>
  </section>
  <section class="container section catalogue" data-catalogue>
    <div class="catalogue-filters">
      {filters.map((filter) => (
        <div class="filter-bar" role="group" aria-label={filter.label}>
          <button
            class="filter-button active"
            data-catalogue-filter={filter.name}
            data-value="all"
            aria-pressed="true"
          >
            {filter.all}
          </button>
          {filter.values.map(([value, label]) => (
            <button
              class="filter-button"
              data-catalogue-filter={filter.name}
              data-value={value}
              aria-pressed="false"
            >
              {label}
            </button>
          ))}
        </div>
      ))}
      <p class="catalogue-count" aria-live="polite" data-catalogue-count>
        {games.length} games
      </p>
    </div>
    <div class="series-stack">
      {series.map((item) => (
        <SeriesBlock series={item} />
      ))}
    </div>
    <p class="catalogue-empty" hidden data-catalogue-empty>
      Nothing matches those filters yet.
    </p>
    <p class="catalogue-more">
      Looking for tools and side projects? They live under
      <a href={url('other-projects/')}>Projects</a>.
    </p>
  </section>
</Layout>
