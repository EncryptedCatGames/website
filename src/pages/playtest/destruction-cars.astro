---
// Private playtest: nothing on the site links here, it is left out of the
// sitemap and search engines are asked not to index it. Share the URL directly.
// The playtest is over for now: the build is no longer embedded. To open the
// next one, bring back the frame and its script from the git history.
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib';
---

<Layout
  title="Destruction Cars playtest | Encrypted Cat Games"
  description="The Destruction Cars (codename) playtest is over for now."
  image="/images/destruction-cars-cover.webp"
  imageAlt="Destruction Cars cover art"
  noindex
>
  <section class="container section playtest">
    <div class="playtest-heading">
      <div>
        <p class="eyebrow">Private playtest</p>
        <h1>Destruction Cars</h1>
        <p class="wip-note">
          Codename · the final game will have a different name
        </p>
      </div>
      <p class="playtest-intro">
        Thanks to everyone who played and sent feedback. We're working through
        it now.
      </p>
    </div>
    <div class="playtest-closed">
      <img
        src={url('images/destruction-cars-cover.webp')}
        alt="Destruction Cars cover art"
        width="1200"
        height="675"
      />
      <div class="playtest-closed-copy">
        <p class="playtest-closed-title">The playtest is over for now</p>
        <p>The next build will be shared here when it's ready.</p>
      </div>
    </div>
    <div class="playtest-actions">
      <a class="text-link" href={url('games/destruction-cars/')}>
        See the game
      </a>
      <a class="text-link" href={url('games/destruction-cars/') + '#devlog'}>
        Read the devlog
      </a>
    </div>
    <p class="playtest-note">
      Want to hear when the next playtest opens? Join us on{' '}
      <a
        href="https://discord.gg/ufYtrP3NRk"
        target="_blank"
        rel="noopener noreferrer"
      >
        Discord
      </a>{' '}
      or write through the <a href={url('contact/')}>contact form</a>.
    </p>
  </section>
</Layout>
