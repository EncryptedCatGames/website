---
// Private playtest: nothing on the site links here, it is left out of the
// sitemap and search engines are asked not to index it. Share the URL directly.
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib';
const build =
  'https://storage.googleapis.com/8a6fa694b1b8544dbb2d19fea040062b/index.html';
---

<Layout
  title="Destruction Cars playtest | Encrypted Cat Games"
  description="Private playtest build of Destruction Cars (codename)."
  image="/images/destruction-cars-cover.webp"
  imageAlt="Destruction Cars cover art"
  noindex
>
  <section class="container section playtest">
    <div class="playtest-heading">
      <div>
        <p class="eyebrow">Private playtest</p>
        <h1>Destruction Cars</h1>
        <p class="wip-note">
          Codename · the final game will have a different name
        </p>
      </div>
      <p class="playtest-intro">
        Thanks for playing an early build. Expect bugs, missing pieces and
        changes between builds. Please don't share this link publicly.
      </p>
    </div>
    <div class="playtest-frame" data-playtest-frame>
      <iframe
        src={build}
        title="Destruction Cars playtest build"
        allow="fullscreen; autoplay; gamepad; accelerometer; gyroscope; screen-wake-lock"
        allowfullscreen
        referrerpolicy="no-referrer"
      ></iframe>
      <button
        class="playtest-tap"
        type="button"
        data-playtest-fullscreen
        aria-label="Play full screen"
      >
        <span>Tap to play full screen</span>
      </button>
      <button class="playtest-exit" type="button" data-playtest-exit>
        ✕ Exit
      </button>
    </div>
    <div class="playtest-actions">
      <button class="text-link" type="button" data-playtest-fullscreen>
        Play full screen
      </button>
      <a class="text-link" href={build} target="_blank" rel="noopener">
        Open in a new tab
      </a>
    </div>
    <p class="playtest-note">
      Turn your phone sideways to play. On iPhone, for a true full screen
      without the address bar, open it in a new tab and use Share → Add to Home
      Screen. Found a bug or have feedback? Tell us on{' '}
      <a
        href="https://discord.gg/ufYtrP3NRk"
        target="_blank"
        rel="noopener noreferrer"
      >
        Discord
      </a>{' '}
      or through the <a href={url('contact/')}>contact form</a>.
    </p>
  </section>
</Layout>

<script>
  // Desktop and Android use the Fullscreen API. iPhone has none for page
  // elements, so there the frame is stretched over the whole page instead.
  // Either way the game sees the real screen shape, so its own "rotate to
  // landscape" screen works (inside a 16:9 box it always looks landscape).
  function setup() {
    const frame = document.querySelector<HTMLElement>('[data-playtest-frame]');
    if (!frame) return;
    const iframe = frame.querySelector('iframe');
    const nativeFullscreen =
      document.fullscreenEnabled &&
      typeof frame.requestFullscreen === 'function';

    const expand = () => {
      frame.classList.add('is-expanded');
      document.documentElement.classList.add('playtest-lock');
      iframe?.focus();
    };
    const collapse = () => {
      frame.classList.remove('is-expanded');
      document.documentElement.classList.remove('playtest-lock');
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    };
    const enter = async () => {
      expand();
      if (!nativeFullscreen) return;
      try {
        await frame.requestFullscreen();
        // Android Chrome can lock to landscape once full screen.
        const orientation = screen.orientation as ScreenOrientation & {
          lock?: (o: string) => Promise<void>;
        };
        await orientation.lock?.('landscape').catch(() => {});
      } catch {
        // Fullscreen refused: the stretched frame still works.
      }
    };

    frame.ownerDocument
      .querySelectorAll<HTMLButtonElement>('[data-playtest-fullscreen]')
      .forEach((button) => (button.onclick = enter));
    frame
      .querySelector<HTMLButtonElement>('[data-playtest-exit]')
      ?.addEventListener('click', collapse);
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) collapse();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') collapse();
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
