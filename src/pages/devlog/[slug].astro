---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url, formatDate } from '../../lib';
import { gameName } from '../../data/games';
export async function getStaticPaths() {
  return (await getCollection('devlog')).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} | Encrypted Cat Games`}
  description={post.data.description}
  image={post.data.image || `/images/${post.data.game}-cover.webp`}
  imageAlt={`${post.data.title}, The Cradle: ${gameName(post.data.game)}`}
  type="article"
>
  <article class="container article">
    <header class="article-header">
      <a class="back-link" href={url('devlog/')}>
        Devlog
      </a>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <span>{gameName(post.data.game)}</span>
      </p>
      <h1>{post.data.title}</h1>
      <p class="article-source">
        By Encrypted Cat / 0xKOT · Originally published on{' '}
        <a href={post.data.source} target="_blank" rel="noopener noreferrer">
          itch.io
        </a>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <div class="article-end">
      <a class="text-link" href={url(`games/${post.data.game}/`)}>
        Explore the game
      </a>
      <a class="text-link" href={url('devlog/')}>
        More development notes
      </a>
    </div>
  </article>
</Layout>
