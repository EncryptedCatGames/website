---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { series } from '../../data/series';
import { subjectSeries } from '../../data/subjects';
import { projects } from '../../data/projects';
import { url } from '../../lib';
const posts = (await getCollection('devlog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
// A project gets a filter only once it has posts (OpenWhisp's live on its own site).
const postedProjects = projects.filter((project) =>
  posts.some((post) => post.data.game === project.slug),
);
---

<Layout
  title="Devlog | Encrypted Cat Games"
  description="Development notes, updates and behind-the-scenes stories from The Cradle, Destruction Cars and our other projects."
>
  <section class="container page-intro">
    <p class="eyebrow">From the workshop</p>
    <h1>Devlog.</h1>
    <p>
      New builds, patches and the work behind every game and project. Pick a
      series to follow just that one.
    </p>
    <a class="text-link" href={url('devlog/rss.xml')}>
      Follow with RSS
    </a>
  </section>
  <section class="container section devlog-index">
    <div class="filter-bar" role="group" aria-label="Filter devlog by game">
      <button
        class="filter-button active"
        data-filter="all"
        aria-pressed="true"
      >
        All updates
      </button>
      {series.map((item) => (
        <button
          class="filter-button"
          data-filter={item.slug}
          aria-pressed="false"
        >
          {item.name}
        </button>
      ))}
      {postedProjects.map((project) => (
        <button
          class="filter-button"
          data-filter={project.slug}
          aria-pressed="false"
        >
          {project.name}
        </button>
      ))}
      <span id="post-count" aria-live="polite">
        {posts.length} posts
      </span>
    </div>
    {posts.map((post) => (
      <div data-post-series={subjectSeries(post.data.game)}>
        <PostList posts={[post]} />
      </div>
    ))}
  </section>
</Layout>
