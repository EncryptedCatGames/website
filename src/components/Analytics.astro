---
import site from '../../site.config.mjs';
import { url } from '../lib';
const enabled =
  /^G-[A-Z0-9]+$/.test(site.analyticsId) && site.analyticsId !== 'G-XXXXXXXXXX';
---

<div
  id="site-analytics"
  transition:persist="site-analytics"
  data-ga-id={enabled ? site.analyticsId : ''}
>
  {enabled && (
    <section
      class="consent"
      aria-labelledby="consent-title"
      hidden
      data-consent-banner
    >
      <p class="consent-title" id="consent-title">
        Can we count your visit?
      </p>
      <p class="consent-text">
        With your permission we use Google Analytics to see which pages people
        visit. No ads, no tracking across other sites. You can change this any
        time from the footer. <a href={url('privacy/')}>Privacy policy</a>
      </p>
      <div class="consent-actions">
        <button type="button" data-consent="granted">
          Allow
        </button>
        <button type="button" data-consent="denied">
          Decline
        </button>
      </div>
    </section>
  )}
</div>

<script>
  // Analytics loads only after a visitor allows it; the choice is kept in this browser.
  const KEY = 'ecg-analytics-consent';
  const container = document.querySelector<HTMLElement>('#site-analytics')!;
  const id = container.dataset.gaId;
  const banner = container.querySelector<HTMLElement>('[data-consent-banner]');
  const win = window as typeof window & {
    dataLayer: unknown[];
    gtag?: (...args: unknown[]) => void;
  };
  function readChoice() {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }
  function saveChoice(choice: string) {
    try {
      localStorage.setItem(KEY, choice);
    } catch {}
  }
  function load() {
    if (!id || win.gtag) return;
    win.dataLayer ||= [];
    const gtag = function (..._args: unknown[]) {
      // gtag.js expects the arguments object itself, not an array.
      win.dataLayer.push(arguments);
    };
    win.gtag = gtag;
    gtag('consent', 'default', {
      analytics_storage: 'granted',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });
    gtag('js', new Date());
    gtag('config', id, {
      send_page_view: true,
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });
    const script = document.createElement('script');
    script.async = true;
    script.dataset.astroExec = '';
    script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
    container.append(script);
  }
  function stop() {
    win.gtag?.('consent', 'update', { analytics_storage: 'denied' });
    // Remove the analytics cookies already set on this site.
    for (const cookie of document.cookie.split(';')) {
      const name = cookie.split('=')[0].trim();
      if (!name.startsWith('_ga')) continue;
      for (const domain of ['', location.hostname, `.${location.hostname}`])
        document.cookie = `${name}=; Max-Age=0; path=/${domain && `; domain=${domain}`}`;
    }
  }
  function setBanner(open: boolean) {
    if (banner) banner.hidden = !open;
  }

  if (id) {
    const choice = readChoice();
    if (choice === 'granted') load();
    else if (choice !== 'denied') setBanner(true);
  }
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const answer = event.target.closest<HTMLElement>('[data-consent]');
    if (answer) {
      const choice = answer.dataset.consent!;
      saveChoice(choice);
      setBanner(false);
      if (choice === 'granted') {
        if (win.gtag)
          win.gtag('consent', 'update', { analytics_storage: 'granted' });
        else load();
      } else stop();
      return;
    }
    if (event.target.closest('[data-consent-open]') && id) {
      setBanner(true);
      banner?.querySelector<HTMLButtonElement>('[data-consent]')?.focus();
    }
  });
</script>

<style>
  .consent {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    width: min(420px, calc(100% - 32px));
    padding: 20px;
    border: 1px solid #343b2c;
    border-radius: 10px;
    background: #121510;
    box-shadow: 0 16px 40px #00000080;
    color: #e9e5d8;
    font:
      14px/1.6 'IBM Plex Sans',
      system-ui,
      sans-serif;
  }
  .consent-title {
    margin: 0 0 6px;
    font-weight: 500;
  }
  .consent-text {
    margin: 0 0 16px;
    font-size: 13px;
    color: #b0afa7;
  }
  .consent-text a {
    color: #c7ad75;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .consent-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .consent-actions button {
    min-height: 44px;
    border: 1px solid #474d41;
    border-radius: 6px;
    background: #1b2017;
    color: #e9e5d8;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .consent-actions button:hover {
    border-color: #8e815f;
    background: #20251b;
  }
  .consent-actions button:focus-visible,
  .consent-text a:focus-visible {
    outline: 2px solid #c7ad75;
    outline-offset: 3px;
  }
  @media (max-width: 767px) {
    .consent {
      right: 12px;
      bottom: 12px;
      width: calc(100% - 24px);
      padding: 16px;
    }
  }
</style>
