---
import { url } from '../lib';
interface Props {
  name: string;
}
const { name } = Astro.props;
const icons: Record<string, string> = {
  'itch.io': 'itchdotio',
  Discord: 'discord',
  Reddit: 'reddit',
  YouTube: 'youtube',
  Twitch: 'twitch',
};
---

<img
  class="social-icon"
  src={url(`icons/${icons[name]}.svg`)}
  alt=""
  aria-hidden="true"
  width="18"
  height="18"
/>

<style>
  .social-icon {
    display: block;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    object-fit: contain;
    filter: invert(92%) sepia(9%) saturate(299%) hue-rotate(5deg)
      brightness(99%) contrast(89%);
    opacity: 0.8;
  }
</style>
