---
import LinkMark from './LinkMark.astro';
import { url } from '../lib';
const { game } = Astro.props;
const details = url(`games/${game.slug}/`);
---

<article
  class="game-card"
  data-game={game.slug}
  data-item
  data-type="game"
  data-platforms={game.platformTags.join(' ')}
>
  <a href={details} class="game-image" tabindex="-1" aria-hidden="true">
    <img
      src={url(game.cover)}
      alt=""
      width="1200"
      height="675"
      loading="lazy"
    />
  </a>
  <div class="game-copy">
    <p class="game-kind">{game.kind}</p>
    <h3>
      <a href={details}>
        <small>{game.title}</small>
        {game.subtitle}
      </a>
    </h3>
    <p class="game-description">{game.short}</p>
    <ul class="game-meta" aria-label="Details">
      <li class="game-status">{game.status}</li>
      <li>{game.length}</li>
      <li>{game.platforms}</li>
    </ul>
    <div class="game-actions">
      <a
        class="button button-small"
        href={game.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Play ${game.title}: ${game.subtitle} on itch.io`}
      >
        Play <LinkMark external />
      </a>
      <a
        class="button button-small button-secondary"
        href={details}
        aria-label={`${game.title}: ${game.subtitle} details`}
      >
        Details <LinkMark />
      </a>
    </div>
  </div>
</article>
