---
import { url } from '../lib';
import { fullName } from '../data/games';
const { game } = Astro.props;
const name = fullName(game);
const details = url(`games/${game.slug}/`);
---

<article
  class="game-card"
  data-game={game.slug}
  data-item
  data-type="game"
  data-platforms={game.platformTags.join(' ')}
>
  <a href={details} class="game-image" tabindex="-1" aria-hidden="true">
    <img
      src={url(game.cover)}
      alt=""
      width="1200"
      height="675"
      loading="lazy"
    />
  </a>
  <div class="game-copy">
    <p class="game-kind">{game.kind}</p>
    <h3>
      <a href={details}>
        {game.subtitle ? (
          <>
            <small>{game.title}</small>
            {game.subtitle}
          </>
        ) : (
          <>
            <small>{game.workingTitle ? 'Working title' : ' '}</small>
            {game.title}
          </>
        )}
      </a>
    </h3>
    <p class="game-description">{game.short}</p>
    <ul class="game-meta" aria-label="Details">
      <li class="game-status">{game.status}</li>
      <li>{game.length}</li>
      <li>{game.platforms}</li>
    </ul>
    <div class="game-actions">
      {game.url ? (
        <a
          class="text-link"
          href={game.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Play ${name} on itch.io`}
        >
          Play on itch.io
        </a>
      ) : (
        game.trailer && (
          <a
            class="text-link"
            href={`${details}#trailer`}
            aria-label={`Watch the ${name} teaser`}
          >
            Watch the teaser
          </a>
        )
      )}
      <a class="text-link" href={details} aria-label={`${name} details`}>
        Details
      </a>
    </div>
  </div>
</article>
