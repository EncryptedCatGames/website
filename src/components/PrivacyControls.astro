---
import site from '../../site.config.mjs';
import { url } from '../lib';
const enabled =
  /^G-[A-Z0-9]+$/.test(site.analyticsId) && site.analyticsId !== 'G-XXXXXXXXXX';
---

<div
  id="analytics-consent"
  class="consent"
  transition:persist="privacy-controls"
  hidden
  data-ga-id={enabled ? site.analyticsId : ''}
>
  <p>
    Allow Google Analytics to measure page visits? Optional analytics stay off
    until you accept. <a href={url('privacy/')}>Privacy details</a>
  </p>
  <div>
    <button type="button" class="button button-small" data-analytics="granted">
      Accept analytics
    </button>
    <button
      type="button"
      class="button button-secondary button-small"
      data-analytics="denied"
    >
      Decline
    </button>
  </div>
</div>
<script>
  // This module runs once. The panel and consent state survive client navigation.
  const panel = document.querySelector<HTMLElement>('#analytics-consent')!;
  const id = panel.dataset.gaId;
  const key = 'ecg-analytics-consent';
  let loaded = false;
  function readChoice() {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }
  let choice = readChoice();
  type AnalyticsWindow = typeof window & {
    dataLayer: unknown[];
    gtag?: (...args: unknown[]) => void;
    [key: string]: unknown;
  };
  const win = window as AnalyticsWindow;
  function loadAnalytics() {
    if (!id || loaded) return;
    loaded = true;
    win.dataLayer ||= [];
    win.gtag = function () {
      win.dataLayer.push(arguments);
    };
    win.gtag('consent', 'default', {
      analytics_storage: 'granted',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });
    win.gtag('js', new Date());
    win.gtag('config', id, {
      send_page_view: false,
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
    panel.append(script);
  }
  function trackPage() {
    if (loaded && choice === 'granted')
      win.gtag?.('event', 'page_view', {
        page_location: location.href,
        page_title: document.title,
      });
  }
  document.addEventListener('astro:page-load', () => {
    if (!id) return;
    if (choice === 'granted') {
      loadAnalytics();
      trackPage();
    } else if (choice !== 'denied') panel.hidden = false;
  });
  // Delegation also covers the privacy-settings button inside a newly swapped page.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>(
      '[data-analytics], [data-privacy-settings]',
    );
    if (!button) return;
    if (button.hasAttribute('data-privacy-settings')) {
      if (id) panel.hidden = false;
      else {
        const note = document.querySelector('#analytics-disabled');
        if (note) {
          note.removeAttribute('hidden');
          note.scrollIntoView({ block: 'center' });
        }
      }
      return;
    }
    choice = button.dataset.analytics!;
    try {
      localStorage.setItem(key, choice);
    } catch {
      /* Keep the choice for this session. */
    }
    panel.hidden = true;
    if (choice === 'granted') {
      loadAnalytics();
      trackPage();
    } else if (loaded) {
      win[`ga-disable-${id}`] = true;
      win.gtag?.('consent', 'update', { analytics_storage: 'denied' });
      for (const cookie of document.cookie.split(';')) {
        const name = cookie.split('=')[0].trim();
        if (!name.startsWith('_ga')) continue;
        const parts = location.hostname.split('.');
        for (let i = 0; i < parts.length - 1; i++)
          document.cookie = `${name}=; Max-Age=0; path=/; domain=.${parts.slice(i).join('.')}`;
        document.cookie = `${name}=; Max-Age=0; path=/`;
      }
      location.reload();
    }
  });
</script>
