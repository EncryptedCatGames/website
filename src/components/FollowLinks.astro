---
// The studio's channels as one row of chips: the hero, the footer and the mobile menu.
import SocialIcon from './SocialIcon.astro';
import site from '../../site.config.mjs';
const { notes = true, label = 'Follow the studio' } = Astro.props;
const what: Record<string, string> = {
  Discord: 'Chat with us',
  YouTube: 'Trailers',
  Reddit: 'Discussion',
  'itch.io': 'New releases',
  Twitch: 'Live dev',
};
---

<ul class="follow-links" aria-label={label}>
  {site.socials.map((s) => (
    <li>
      <a
        class="follow-chip"
        href={s.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <SocialIcon name={s.name} />
        <span>
          <strong>{s.name}</strong>
          {notes && <small>{what[s.name]}</small>}
        </span>
      </a>
    </li>
  ))}
</ul>
