---
interface Props {
  external?: boolean;
}
const { external = false } = Astro.props;
---

<span
  class:list={['link-mark', { 'link-mark-external': external }]}
  aria-hidden="true"
>
  <svg viewBox="0 0 24 24" fill="none" focusable="false">
    {external ? (
      <>
        <path d="M11 4H5v16h6" />
        <path d="M10 12h11m-4-4 4 4-4 4" />
        <path class="door-edge" d="M11 4v16" />
      </>
    ) : (
      <path d="M3 12h17m-5-5 5 5-5 5" />
    )}
  </svg>
</span>

<style>
  svg {
    display: block;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .door-edge {
    opacity: 0.35;
  }
</style>
