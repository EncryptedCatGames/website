---
import LinkMark from './LinkMark.astro';
import { url, formatDate } from '../lib';
import { gameName } from '../data/games';
const { posts } = Astro.props;
// Thumbnails come from scripts/make-thumbs.mjs.
const thumb = (post: any) =>
  (post.data.image || `/images/${post.data.game}-cover.webp`).split('/').pop();
---

<div class="post-list">
  {posts.map((post: any) => (
    <article class="post-row">
      <a
        class:list={['post-thumb', { 'post-thumb-cover': !post.data.image }]}
        href={url(`devlog/${post.id}/`)}
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          src={url(`/images/thumbs/${thumb(post)}`)}
          alt=""
          width="320"
          height="200"
          loading="lazy"
        />
      </a>
      <div>
        <p class="post-meta">
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <span>{gameName(post.data.game)}</span>
        </p>
        <h3>
          <a href={url(`devlog/${post.id}/`)}>{post.data.title}</a>
        </h3>
      </div>
      <a
        class="post-arrow"
        href={url(`devlog/${post.id}/`)}
        aria-label={`Read ${post.data.title}`}
      >
        <LinkMark />
      </a>
    </article>
  ))}
</div>
